# 临时脚本 / 中间产物（本项目工作区习惯：以 _tmp_ 前缀命名）
_tmp_*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
# pytest 在 server/ 下留下的临时目录（tmp_path 夹具产物，跑一次 L3 就冒一批）
server/pytest-of-*/
server/tmp*/
.pytest_cache/

# 本机工具配置（CommandCode；含个人 taste 配置，不入库）
.commandcode/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# 日志与导出产物
*.log
_build/
_out/

# AgentTeams 插件运行状态（不入库）
.agent-teams/

# 鸿蒙 / hvigor：依赖与构建产物不入库（由 ohpm install / hvigorw 生成）
oh_modules/
.hvigor/
app/**/build/
# hvigorw test 生成的本地单测中间产物（入口临时工程 + 编译缓存），与 build/ 同类
app/**/.test/
app/**/.cxx/
local.properties
*.hap
*.har
