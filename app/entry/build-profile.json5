/**
 * entry 模块构建配置（Stage 模型 · HarmonyOS SDK / 目标 API 24）。
 *
 * 版本口径见 app/build-profile.json5 头部：`runtimeOS: HarmonyOS` + `compatibleSdkVersion "6.1.1(24)"`。
 *
 * 两个 target：
 *  - `default`：主 HAP（`src/main`）
 *  - `ohosTest`：单元测试 HAP（`src/ohosTest`），仅测试构建（`buildMode=test`）时生效
 */
{
  "apiType": "stageMode",
  "buildOption": {},
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest"
    }
  ]
}
