# CarbonBoo 服务端环境变量样例  —— server/.env.example
#
# 用法：
#   cd server
#   cp .env.example .env
#   # 生成两把互不相同的密钥（复制两行的输出分别填入下面两处）：
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#   chmod 600 .env          # ★ 硬性要求：密钥只进 .env，权限 600（AGENTS §6 安全）
#
# 规则（AGENTS §6 / §7.2，APPENDIX-B §5.2）：
#   * .env 不进仓库（见仓库根 .gitignore）；代码内**没有任何默认密钥**，缺失即启动失败。
#   * JWT_SECRET 与 ADMIN_JWT_SECRET 必须是**两把独立密钥且不相同**：客户端 token 访问任何 /admin/* 只能拿到 403。
#   * MySQL 只监听 127.0.0.1；公网只开 SSH/80/443。
#   * 生产环境 APP_ENV=prod 且 DOCS_URL 留空（默认关闭 /docs，路演前临时开）。

# ---------- 运行环境 ----------
APP_ENV=dev                       # dev | test | prod
APP_HOST=127.0.0.1                # 只监听本机；对外由 Nginx/TLS 终结
APP_PORT=8000
API_PREFIX=/api/v1
APP_VERSION=1.0.0                 # GET /api/v1/health 的 version 字段（附录 B §5.1 示例为 1.0.0）
DOCS_URL=/docs                    # 置空 = 关闭 /docs 与 /openapi.json
DOCS_ENABLED=                     # 留空=按环境默认（非生产开、生产关）；true/false = 显式开关（路演前临时开）

# ---------- MySQL（只监听 127.0.0.1） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=carbonboo
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_DB=carbonboo

# ---------- SQLAlchemy 连接池 ----------
# --workers 2 时必须显式收口：2×(POOL_SIZE+MAX_OVERFLOW)=2×(5+5)=20 < max_connections=30
# （默认 5+10 会变成 2×15=30，正好打满 max_connections=30，见 AGENTS §7.2）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------- 客户端（App）JWT —— 密钥 ① ----------
JWT_SECRET=__CHANGE_ME_AT_LEAST_32_CHARS__
JWT_ALGORITHM=HS256
JWT_ISSUER=carbonboo-server
JWT_USER_AUDIENCE=carbonboo-client
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=10080    # 7 天

# ---------- 管理端（Web 后台）JWT —— 密钥 ②，必须与 ① 不同 ----------
ADMIN_JWT_SECRET=__CHANGE_ME_ANOTHER_32_CHARS__
JWT_ADMIN_AUDIENCE=carbonboo-admin   # 管理端令牌 audience（与客户端必须不同）
ADMIN_JWT_EXPIRES_MINUTES=120

# ---------- 账号策略 ----------
AUTH_PROVIDER=local               # local | server | huaweiId（后两者为预留，未实现）
ACCOUNT_PURGE_GRACE_DAYS=30       # 注销后云端数据软删除保留 30 天，期内可恢复（ADR-0001）
LOGIN_RATE_LIMIT_PER_MINUTE=10    # /auth/login 每 (IP+用户名) 每分钟上限
USERNAME_MIN_LENGTH=4            # 附录 B §5.2 错误码表：用户名 4–20 位字母/数字/下划线
USERNAME_MAX_LENGTH=20
PASSWORD_MIN_LENGTH=6            # 附录 B §5.2 错误码表：口令 6–32 位（文档示例口令 abc12345 即 8 位）
PASSWORD_MAX_LENGTH=32
