# ============================================================================
# CarbonBoo · 容器部署环境模板
#
#   首次部署：cp .env.example .env && chmod 600 .env，然后把所有 CHANGE_ME 换成真值。
#   .env 由 server/.gitignore 的 `.env` 规则（任意层级）忽略，**绝不入库**。
#
#   生成密钥（够 32 位、且两把必须不同）：
#     openssl rand -hex 32
#     openssl rand -hex 32
# ============================================================================

# ---------- 运行环境 ----------
# 生产必须是 prod：此时 MySQL 连不上会让容器启动失败（宁可起不来，也不要起来了每个请求都 500）
APP_ENV=prod
# API 版本号（/api/v1/health 的 version 字段，逐字对齐附录 B §5.1）
APP_VERSION=1.0.0

# ---------- MySQL（容器内网：主机名 = compose 服务名 mysql） ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
# 库名固定 carbonboo：sql/schema.sql 里写死了 `CREATE DATABASE IF NOT EXISTS carbonboo`
MYSQL_DB=carbonboo
MYSQL_USER=carbonboo
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD

# MySQL 容器 root 口令（只在容器内 127.0.0.1 生效；备份脚本用它走 mysqldump）
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ---------- JWT（两把独立密钥，均 >=32 位且互不相同，否则启动即 ValueError） ----------
JWT_SECRET=CHANGE_ME_64_HEX_CLIENT_SECRET
ADMIN_JWT_SECRET=CHANGE_ME_64_HEX_ADMIN_SECRET

# ---------- 账号策略 ----------
AUTH_PROVIDER=local
LOGIN_RATE_LIMIT_PER_MINUTE=10
ACCOUNT_PURGE_GRACE_DAYS=30

# ---------- /docs（AGENTS §6：生产默认关闭；留空 = 按环境默认，prod 即关闭） ----------
DOCS_ENABLED=
# 路演时临时打开：DOCS_ENABLED=true

# ---------- Web 后台管理端（可选件） ----------
# 首次管理员引导：仅当 admin_user 表为空时生效，用过一次就彻底失效
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# 当前只有 HTTP（无域名/证书）：prod 下 Cookie 会被置 Secure，浏览器在 http:// 下不会保存，
# 后台页面会「登录成功但立刻又跳回登录页」。故显式关掉；配上 TLS 后改成 true。
ADMIN_COOKIE_SECURE=false
# 图标落盘目录（与 compose 的 admin_uploads 命名卷挂载点一致）
ADMIN_UPLOAD_DIR=/app/admin_web/static/uploads/icons
ADMIN_MAX_ICON_BYTES=524288
